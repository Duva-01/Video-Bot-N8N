# n8n runtime
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
GENERIC_TIMEZONE=Europe/Madrid
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_EDITOR_BASE_URL=https://your-service.onrender.com
WEBHOOK_URL=https://your-service.onrender.com

# n8n secrets
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value

# database
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-neon-host
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=neondb
DB_POSTGRESDB_USER=your-user
DB_POSTGRESDB_PASSWORD=your-password
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
NEON_DATABASE_URL=postgres://user:password@host/db?sslmode=require

# content generation
GROQ_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=

# publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
